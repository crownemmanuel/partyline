{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PartyLine",
  "version": "../package.json",
  "identifier": "app.partyline.desktop",
  "build": {
    "frontendDist": "../../../packages/web-client/dist",
    "beforeBuildCommand": "npm --prefix ../../packages/web-client run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PartyLine",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/livekit-server"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "resources": [
      "resources/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGQUEyMTkyODY1NkEzOTEKUldTUm8xYUdraUdxM3l6MFlpNlJFQmZHR01tS3h1NVVJTUdQQ1k4aElzL0t3c1l2dHN4dVlTVFUK",
      "endpoints": [
        "https://github.com/crownemmanuel/partyline/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
